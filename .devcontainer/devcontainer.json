// .devcontainer/devcontainer.json
// Grafana development container
// Based on: https://github.com/grafana/grafana/blob/main/contribute/developer-guide.md
{
  "name": "Grafana Development",

  // 1.25-bookworm is the newest available devcontainer tag.
  // Go is upgraded to 1.26.3 (matching go.mod) in postCreateCommand below.
  "image": "mcr.microsoft.com/devcontainers/go:1-1.25-bookworm",

  // ─── Features ────────────────────────────────────────────────────────────────
  "features": {
    // Node.js 24 LTS with corepack — required for yarn
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24",
      "nodeGypDependencies": true
    },
    // Docker-in-Docker — required for `make devenv sources=...`
    "ghcr.io/devcontainers/features/docker-in-docker:3.0.0": {
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    }
  },

  // ─── Open-file limit ─────────────────────────────────────────────────────────
  // `make run` and `yarn start` watch large file trees and will hit the default
  // nofile limit of 1024. The developer guide recommends at least 8000.
  "runArgs": ["--ulimit", "nofile=65536:65536"],

  // ─── inotify watchers ────────────────────────────────────────────────────────
  // Prevents `ENOSPC: System limit for number of file watchers reached`
  // during `yarn start`. Runs on the host before the container is created.
  "initializeCommand": "echo 'fs.inotify.max_user_watches=524288' | sudo tee -a /etc/sysctl.conf > /dev/null 2>&1 || true",

  // ─── Post-create setup ────────────────────────────────────────────────────────
  // Single string so steps run strictly in order:
  //   1. Upgrade Go to 1.26.3 (matching go.mod)
  //   2. Enable corepack and install the pinned yarn version
  //   3. Install frontend dependencies
  "postCreateCommand": "curl -fsSL https://go.dev/dl/go1.26.3.linux-amd64.tar.gz | sudo tar -C /usr/local -xz && sudo ln -sf /usr/local/go/bin/go /usr/local/bin/go && sudo ln -sf /usr/local/go/bin/gofmt /usr/local/bin/gofmt && corepack enable && corepack install && yarn install --immutable",

  // ─── Environment variables ────────────────────────────────────────────────────
  "remoteEnv": {
    // Prevents Node heap-out-of-memory errors during `yarn start` / tsc.
    // Lower to 4096 if your host has limited RAM.
    "NODE_OPTIONS": "--max-old-space-size=8192",

    // Matches the production build profile. Set to "1" if you need the
    // CGO SQLite driver for local development.
    "CGO_ENABLED": "0",

    // Ensure Go tools installed via `go install` are on PATH.
    "GOPATH": "/go",
    "PATH": "${containerEnv:PATH}:/go/bin"
  },

  // ─── Forwarded ports ──────────────────────────────────────────────────────────
  "forwardPorts": [
    3000, // Grafana web server (`make run`)
    3333  // Webpack dev server (`yarn start`)
  ],

  "portsAttributes": {
    "3000": { "label": "Grafana", "onAutoForward": "openBrowser" },
    "3333": { "label": "Webpack Dev Server", "onAutoForward": "notify" }
  },

  // ─── VS Code extensions ───────────────────────────────────────────────────────
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",              // Go language support
        "dbaeumer.vscode-eslint", // ESLint for the frontend
        "esbenp.prettier-vscode"  // Prettier formatter
      ],
      "settings": {
        "go.toolsManagement.autoUpdate": true,
        "typescript.tsdk": "node_modules/typescript/lib",
        "typescript.enablePromptUseWorkspaceTsdk": true
      }
    }
  },

  "remoteUser": "vscode"
}